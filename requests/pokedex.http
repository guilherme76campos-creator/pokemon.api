@baseUrl = http://localhost:8080

###
# 1) findAll - GET /pokemon   -> 200 OK (ou 404 se a pokedex estiver vazia)
GET {{baseUrl}}/pokemon

###
# 2) findByCodigo - GET /pokemon/1   -> 200 OK (ou 404)
GET {{baseUrl}}/pokemon/1

###
# 3) save - POST /pokemon   -> 201 CREATED (ou 400 se invalido)
POST {{baseUrl}}/pokemon
Content-Type: application/json

{
  "nome": "Eevee",
  "tipo": "Normal",
  "nivel": 18,
  "dataCaptura": "2025-02-14"
}

###
# 3.1) save invalido: data no futuro   -> 400 BAD REQUEST
POST {{baseUrl}}/pokemon
Content-Type: application/json

{
  "nome": "FuturoMon",
  "tipo": "Fogo",
  "nivel": 10,
  "dataCaptura": "2099-01-01"
}

###
# 4) update - PUT /pokemon/1   -> 201 CREATED (ou 400 / 404)
PUT {{baseUrl}}/pokemon/1
Content-Type: application/json

{
  "nome": "Bulbasaur",
  "tipo": "Planta",
  "nivel": 12,
  "dataCaptura": "2024-03-10"
}

###
# 5) delete - DELETE /pokemon/1   -> 204 NO CONTENT (ou 404)
DELETE {{baseUrl}}/pokemon/1

###
# 6) CORS preflight - OPTIONS /pokemon   -> 200 com Access-Control-Allow-Origin
OPTIONS {{baseUrl}}/pokemon
Origin: http://localhost:5500
Access-Control-Request-Method: POST
Access-Control-Request-Headers: content-type
